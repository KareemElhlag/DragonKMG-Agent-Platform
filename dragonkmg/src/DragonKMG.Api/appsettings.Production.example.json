{
  "DragonKMG": {
    "Environment": "Production",
    "Database": {
      "Provider": "sqlite"
    },
    "Mcp": {
      "RegistryPath": "./config/mcp-servers.json",
      "ExecuteScope": "dragonkmg.mcp.execute"
    },
    "Backups": {
      "Directory": "./backups"
    }
  },
  "Authentication": {
    "Oidc": {
      "Enabled": true,
      "Authority": "https://YOUR_OIDC_AUTHORITY",
      "Issuer": "https://YOUR_OIDC_ISSUER",
      "Audience": "dragonkmg-api",
      "RequiredScope": "dragonkmg.api",
      "RequireHttpsMetadata": true,
      "ClockSkewSeconds": 60
    }
  }
}
